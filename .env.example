# Copy to .env and fill in secrets. Do not commit .env.

# Snowflake connector and local dbt (pipeline/dbt_local/profiles.yml)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DATAAGENT
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DATABASE=DEMO_DB
SNOWFLAKE_SCHEMA=DEMO_SCHEMA

# GitHub token needs contents and pull-request access on the pipeline repo
GITHUB_TOKEN=
GITHUB_REPO=bedirachit/snowflake-sales-aggregate-dbt

# Required for the Claude agent. The rule-based healer works without it.
ANTHROPIC_API_KEY=

# Watcher and default single-pipeline target
AGENT_POLL_INTERVAL_SEC=30
AGENT_DEMO_TAG=demo_sales_etl
DBT_MODEL_GITHUB_PATH=pipeline/dbt/models/marts/sales_summary.sql
DBT_PROJECT_OBJECT=DEMO_DB.DEMO_SCHEMA.SNOWFLAKES_SALES
DBT_MODEL_SELECT=sales_summary
PROJECT_ROOT=

# Streamlit login. Change the password before sharing the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
